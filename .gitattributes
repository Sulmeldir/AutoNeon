# Normalize text files by default and keep repository line endings predictable.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Source code and project configuration should stay LF across platforms.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.hh text eol=lf
*.ino text eol=lf
*.py text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf

# Windows command scripts are more convenient with CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.webp binary
*.zip binary
*.gz binary
*.7z binary
*.bin binary
*.elf binary
